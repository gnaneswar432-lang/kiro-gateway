//@version=5
// =============================================================================
//  SMT Divergence Pro — Indian Markets Edition
//  Author: Kiro Mentor Guide
//  Purpose: Auto-detect Smart Money Technique (SMT) divergence between a
//           current chart and a correlated symbol, plus liquidity & A+ context.
//
//  Use it on:   NIFTY 5m / 15m   (compare = BANKNIFTY)
//               BANKNIFTY 5m / 15m (compare = NIFTY)
//               FINNIFTY 5m       (compare = BANKNIFTY)
//               Any stock vs sector index (e.g., HDFCBANK vs BANKNIFTY)
//
//  IMPORTANT: This is an EDUCATIONAL tool. It marks possible setups.
//             It does NOT guarantee profit. Always use the A+ checklist,
//             risk <= 1% per trade, and journal every trade.
// =============================================================================

indicator("SMT Divergence Pro [Indian]", "SMT Pro", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ===================== INPUTS =====================
g1 = "▶ Correlation Pair"
cmpSym = input.symbol("NSE:BANKNIFTY", "Compare Symbol", group=g1,
     tooltip="If you're on NIFTY → set BANKNIFTY. If on BANKNIFTY → set NIFTY.\n\nOther useful Indian pairs:\n• NSE:CNXFINANCE (FINNIFTY)\n• BSE:SENSEX\n• NSE:NIFTY_MID_SELECT (Nifty Midcap)")

g2 = "▶ Pivot / Swing"
pivLen = input.int(5, "Swing length (bars left/right)", minval=2, maxval=30, group=g2,
     tooltip="Lower = more signals, more noise. 3–5 for scalping, 5–8 intraday, 10+ swing.")

g3 = "▶ Display"
showSMT     = input.bool(true,  "Show SMT divergence labels", group=g3)
showLines   = input.bool(true,  "Connect divergent pivots with line", group=g3)
showFVG     = input.bool(true,  "Show Fair Value Gaps (FVG)", group=g3)
showPDHL    = input.bool(true,  "Show PDH / PDL", group=g3)
showSessHL  = input.bool(true,  "Show today's session H/L", group=g3)
showPanel   = input.bool(true,  "Show A+ checklist panel", group=g3)

g4 = "▶ Alerts"
alertBull = input.bool(true, "Alert on Bullish SMT", group=g4)
alertBear = input.bool(true, "Alert on Bearish SMT", group=g4)

g5 = "▶ Colors"
colBull = input.color(color.new(#22c98a, 0),  "Bullish SMT", group=g5)
colBear = input.color(color.new(#ff5b6b, 0),  "Bearish SMT", group=g5)
colFvgB = input.color(color.new(#22c98a, 80), "Bullish FVG fill", group=g5)
colFvgS = input.color(color.new(#ff5b6b, 80), "Bearish FVG fill", group=g5)
colPDH  = input.color(color.new(#ffb454, 0),  "PDH / PDL", group=g5)
colSess = input.color(color.new(#5cf2c5, 0),  "Session H/L", group=g5)

// ===================== DATA FROM CORRELATED SYMBOL =====================
[cHigh, cLow] = request.security(cmpSym, timeframe.period, [high, low],
     lookahead=barmerge.lookahead_off)

// Previous day H/L for the CURRENT symbol
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)

// ===================== PIVOT DETECTION =====================
phMain = ta.pivothigh(high,  pivLen, pivLen)
plMain = ta.pivotlow (low,   pivLen, pivLen)
phCmp  = ta.pivothigh(cHigh, pivLen, pivLen)
plCmp  = ta.pivotlow (cLow,  pivLen, pivLen)

// Track last two confirmed pivots
var float ph1m = na, var int    ph1m_bar = na
var float ph0m = na, var int    ph0m_bar = na
var float pl1m = na, var int    pl1m_bar = na
var float pl0m = na, var int    pl0m_bar = na

var float ph1c = na
var float ph0c = na
var float pl1c = na
var float pl0c = na

if not na(phMain)
    ph0m     := ph1m
    ph0m_bar := ph1m_bar
    ph1m     := phMain
    ph1m_bar := bar_index - pivLen

if not na(plMain)
    pl0m     := pl1m
    pl0m_bar := pl1m_bar
    pl1m     := plMain
    pl1m_bar := bar_index - pivLen

if not na(phCmp)
    ph0c := ph1c
    ph1c := phCmp

if not na(plCmp)
    pl0c := pl1c
    pl1c := plCmp

// ===================== SMT LOGIC =====================
// Bearish SMT: main makes HIGHER HIGH but compare makes LOWER HIGH
bearSMT = showSMT and not na(phMain) and not na(ph0m) and not na(ph1c) and not na(ph0c) and ph1m > ph0m and ph1c < ph0c

// Bullish SMT: main makes LOWER LOW but compare makes HIGHER LOW
bullSMT = showSMT and not na(plMain) and not na(pl0m) and not na(pl1c) and not na(pl0c) and pl1m < pl0m and pl1c > pl0c

// ===================== PLOT SMT =====================
if bearSMT
    label.new(ph1m_bar, ph1m, "SMT▼",
         color=colBear, textcolor=color.white,
         style=label.style_label_down, size=size.small)
    if showLines
        line.new(ph0m_bar, ph0m, ph1m_bar, ph1m,
             color=colBear, width=2, style=line.style_dashed)

if bullSMT
    label.new(pl1m_bar, pl1m, "SMT▲",
         color=colBull, textcolor=color.white,
         style=label.style_label_up, size=size.small,
         yloc=yloc.belowbar)
    if showLines
        line.new(pl0m_bar, pl0m, pl1m_bar, pl1m,
             color=colBull, width=2, style=line.style_dashed)

// ===================== FAIR VALUE GAPS =====================
// Bull FVG: low of current candle > high of candle 2 bars ago (3-candle pattern)
// Bear FVG: high of current candle < low of candle 2 bars ago
bullFVG = showFVG and low > high[2] and close > open
bearFVG = showFVG and high < low[2] and close < open

if bullFVG
    box.new(bar_index - 2, high[2], bar_index, low,
         bgcolor=colFvgB, border_color=color.new(#22c98a, 50),
         extend=extend.right, xloc=xloc.bar_index)

if bearFVG
    box.new(bar_index - 2, low[2], bar_index, high,
         bgcolor=colFvgS, border_color=color.new(#ff5b6b, 50),
         extend=extend.right, xloc=xloc.bar_index)

// ===================== PDH / PDL =====================
plot(showPDHL ? pdh : na, "PDH", color=colPDH, linewidth=1, style=plot.style_linebr, trackprice=false)
plot(showPDHL ? pdl : na, "PDL", color=colPDH, linewidth=1, style=plot.style_linebr, trackprice=false)

// Labels for PDH/PDL on last bar
var label lblPDH = na
var label lblPDL = na
if showPDHL and barstate.islast
    label.delete(lblPDH)
    label.delete(lblPDL)
    lblPDH := label.new(bar_index + 5, pdh, "PDH " + str.tostring(pdh, format.mintick),
         style=label.style_label_left, color=colPDH, textcolor=color.black, size=size.small)
    lblPDL := label.new(bar_index + 5, pdl, "PDL " + str.tostring(pdl, format.mintick),
         style=label.style_label_left, color=colPDH, textcolor=color.black, size=size.small)

// ===================== SESSION HIGH / LOW =====================
var float sessHigh = na
var float sessLow  = na
newDay = ta.change(time("D")) != 0

if newDay
    sessHigh := high
    sessLow  := low
else
    sessHigh := math.max(nz(sessHigh, high), high)
    sessLow  := math.min(nz(sessLow,  low),  low)

plot(showSessHL ? sessHigh : na, "Session High", color=colSess, linewidth=1, style=plot.style_linebr)
plot(showSessHL ? sessLow  : na, "Session Low",  color=colSess, linewidth=1, style=plot.style_linebr)

// ===================== A+ CHECKLIST PANEL =====================
hourIST = hour(time, "Asia/Kolkata")
minIST  = minute(time, "Asia/Kolkata")
// Killzones: 9:15-10:15 (open) and 13:30-15:00 (afternoon)
inKZ = (hourIST == 9 and minIST >= 15) or hourIST == 10 and minIST <= 15 or
     (hourIST == 13 and minIST >= 30) or hourIST == 14

if showPanel and barstate.islast
    var table tbl = table.new(position.top_right, 2, 9,
         bgcolor=color.new(#0b1020, 10),
         border_width=1, border_color=color.new(#5cf2c5, 60))

    table.cell(tbl, 0, 0, "A+ CHECKLIST", text_color=color.new(#5cf2c5, 0),
         bgcolor=color.new(#0b1020, 0), text_size=size.normal)
    table.cell(tbl, 1, 0, syminfo.ticker + " vs " + cmpSym,
         text_color=color.white, bgcolor=color.new(#0b1020, 0), text_size=size.small)

    // Row 1: SMT status
    smtTxt = bearSMT ? "BEARISH ▼" : bullSMT ? "BULLISH ▲" : "—"
    smtCol = bearSMT ? colBear : bullSMT ? colBull : color.gray
    table.cell(tbl, 0, 1, "Last SMT",     text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 1, smtTxt,         text_color=smtCol,     text_size=size.small)

    // Row 2: Killzone
    table.cell(tbl, 0, 2, "Time (IST)",   text_color=color.gray, text_size=size.small)
    kzTxt = str.tostring(hourIST) + ":" + (minIST < 10 ? "0" : "") + str.tostring(minIST) + (inKZ ? "  ✓ KZ" : "  ✗ no-trade")
    table.cell(tbl, 1, 2, kzTxt, text_color=inKZ ? colBull : colBear, text_size=size.small)

    // Row 3-4: PDH / PDL
    table.cell(tbl, 0, 3, "PDH",          text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(pdh, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 4, "PDL",          text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(pdl, format.mintick), text_color=color.white, text_size=size.small)

    // Row 5-6: Session H/L
    table.cell(tbl, 0, 5, "Sess High",    text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(sessHigh, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 6, "Sess Low",     text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(sessLow,  format.mintick), text_color=color.white, text_size=size.small)

    // Row 7: Distance to PDH/PDL
    distH = ((close - pdh) / pdh) * 100
    distL = ((close - pdl) / pdl) * 100
    table.cell(tbl, 0, 7, "% to PDH/PDL", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(distH, "+0.00") + "% / " + str.tostring(distL, "+0.00") + "%",
         text_color=color.white, text_size=size.small)

    // Row 8: Action
    action = bearSMT ? "Wait MSS↓ + FVG → SHORT" :
             bullSMT ? "Wait MSS↑ + FVG → LONG"  :
             inKZ    ? "Scan for SMT setup"      :
                       "Out of killzone — wait"
    actCol = bearSMT or bullSMT ? color.new(#ffb454, 0) : color.gray
    table.cell(tbl, 0, 8, "Action",       text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 8, action,         text_color=actCol,     text_size=size.small)

// ===================== ALERTS =====================
if bearSMT and alertBear
    alert("BEARISH SMT on " + syminfo.ticker + " vs " + cmpSym +
         "\nMain made HH at " + str.tostring(ph1m, format.mintick) +
         " but compare made LH." +
         "\nWAIT for MSS down + FVG before short. Risk ≤ 1%.",
         alert.freq_once_per_bar_close)

if bullSMT and alertBull
    alert("BULLISH SMT on " + syminfo.ticker + " vs " + cmpSym +
         "\nMain made LL at " + str.tostring(pl1m, format.mintick) +
         " but compare made HL." +
         "\nWAIT for MSS up + FVG before long. Risk ≤ 1%.",
         alert.freq_once_per_bar_close)

// =============================================================================
// END
// =============================================================================
