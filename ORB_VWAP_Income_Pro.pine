//@version=6
// =============================================================================
//  ORB-VWAP Income Pro — Indian Intraday System
//  Pine Script v6 | Educational use | Not financial advice
//
//  STRATEGY (6 rules):
//   1. Mark first 15-min range (9:15-9:30 IST) = ORB
//   2. After 9:30, breakout above ORB-High -> LONG bias
//                  breakout below ORB-Low  -> SHORT bias
//   3. FILTER: price must agree with VWAP and 50 EMA (trend filter)
//   4. ENTRY:  on close of breakout candle
//   5. SL: opposite ORB level | TP: 1.5R (configurable)
//   6. RISK CONTROLS:
//      - Max 3 trades / day
//      - Stop after 2 losses
//      - No new trades after 14:30 IST
//      - Force exit by 15:15 IST
//
//  Uses strategy() so you see real backtested P&L in Strategy Tester tab.
// =============================================================================

strategy("ORB-VWAP Income Pro [Indian]", "ORB-VWAP",
     overlay = true,
     initial_capital = 200000,
     default_qty_type = strategy.fixed,
     default_qty_value = 75,
     pyramiding = 0,
     commission_type = strategy.commission.cash_per_order,
     commission_value = 20,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 50,
     process_orders_on_close = true)

// ===================== INPUTS =====================
g1 = "Strategy"
orbMin   = input.int(15,  "ORB duration (minutes)", minval = 5, maxval = 60, group = g1,
             tooltip = "First N minutes of the session define the breakout range. 15 is standard for Indian intraday.")
emaLen   = input.int(50,  "Trend EMA length", minval = 10, group = g1)
rrTarget = input.float(1.5, "Take-profit R:R", minval = 1.0, step = 0.1, group = g1,
             tooltip = "Target = entry +/- (SL distance x this multiplier). 1.5 = balanced.")
useVWAP  = input.bool(true, "Require VWAP alignment", group = g1)
useEMA   = input.bool(true, "Require 50 EMA alignment", group = g1)

g2 = "Risk Controls"
maxTrades = input.int(3, "Max trades per day", minval = 1, maxval = 10, group = g2)
maxLosses = input.int(2, "Stop after N losses", minval = 1, maxval = 5, group = g2)

g3 = "Display"
showORB    = input.bool(true, "Show ORB box & lines",  group = g3)
showSignal = input.bool(true, "Show entry arrows",      group = g3)
showLevels = input.bool(true, "Show SL / TP for active trade", group = g3)
showPanel  = input.bool(true, "Show stats panel",       group = g3)

g4 = "Alerts"
alertEntry = input.bool(true, "Alert on new entry", group = g4)
alertExit  = input.bool(true, "Alert on exit",      group = g4)

g5 = "Colors"
colBull = input.color(color.new(#22c98a, 0),  "Long / Bullish",  group = g5)
colBear = input.color(color.new(#ff5b6b, 0),  "Short / Bearish", group = g5)
colORB  = input.color(color.new(#5cf2c5, 80), "ORB fill",        group = g5)
colVWAP = input.color(color.new(#ffb454, 0),  "VWAP",            group = g5)
colEMA  = input.color(color.new(#8a7bff, 30), "EMA",             group = g5)

// ===================== TIME LOGIC (IST) =====================
istHour = hour(time, "Asia/Kolkata")
istMin  = minute(time, "Asia/Kolkata")
mins    = istHour * 60 + istMin

orbStartM  = 9 * 60 + 15            // 09:15
orbEndM    = orbStartM + orbMin     // 09:15 + N
tradeEndM  = 14 * 60 + 30           // 14:30 - no new entries after
forceExitM = 15 * 60 + 15           // 15:15 - close all

inORB    = mins >= orbStartM and mins < orbEndM
afterORB = mins >= orbEndM and mins < tradeEndM
inExit   = mins >= forceExitM
isNewDay = ta.change(time("1D")) != 0

// ===================== STATE =====================
var float orbHigh = na
var float orbLow  = na
var int   orbBar  = na
var int   tradesToday = 0
var int   lossesToday = 0

// Reset every new day
if isNewDay
    orbHigh     := na
    orbLow      := na
    orbBar      := na
    tradesToday := 0
    lossesToday := 0

// Build ORB during the 9:15-9:30 window
if inORB
    if na(orbBar)
        orbBar  := bar_index
        orbHigh := high
        orbLow  := low
    else
        orbHigh := math.max(orbHigh, high)
        orbLow  := math.min(orbLow,  low)

// ===================== INDICATORS =====================
emaVal  = ta.ema(close, emaLen)
vwapVal = ta.vwap(hlc3)

// ===================== SIGNAL LOGIC =====================
canTrade = afterORB and not inExit and tradesToday < maxTrades and lossesToday < maxLosses and not na(orbHigh) and not na(orbLow) and strategy.position_size == 0

vwapLongOK  = not useVWAP or close > vwapVal
vwapShortOK = not useVWAP or close < vwapVal
emaLongOK   = not useEMA  or close > emaVal
emaShortOK  = not useEMA  or close < emaVal

longSig  = canTrade and ta.crossover(close,  orbHigh) and vwapLongOK  and emaLongOK
shortSig = canTrade and ta.crossunder(close, orbLow)  and vwapShortOK and emaShortOK

// ===================== EXECUTION =====================
if longSig
    slPrice = orbLow
    tpPrice = close + (close - orbLow) * rrTarget
    strategy.entry("Long", strategy.long)
    strategy.exit("LongX", from_entry = "Long", stop = slPrice, limit = tpPrice)
    tradesToday += 1

if shortSig
    slPrice = orbHigh
    tpPrice = close - (orbHigh - close) * rrTarget
    strategy.entry("Short", strategy.short)
    strategy.exit("ShortX", from_entry = "Short", stop = slPrice, limit = tpPrice)
    tradesToday += 1

// Force exit at 15:15
if inExit and strategy.position_size != 0
    strategy.close_all(comment = "EOD")

// Track losses
if strategy.closedtrades > strategy.closedtrades[1]
    lastPnL = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastPnL < 0
        lossesToday += 1

// ===================== PLOTS =====================
plot(useVWAP   ? vwapVal : na, "VWAP",          color = colVWAP, linewidth = 2)
plot(useEMA    ? emaVal  : na, "EMA",           color = colEMA,  linewidth = 1)
plot(showORB and not na(orbHigh) ? orbHigh : na, "ORB High", color = colBull, linewidth = 2, style = plot.style_linebr)
plot(showORB and not na(orbLow)  ? orbLow  : na, "ORB Low",  color = colBear, linewidth = 2, style = plot.style_linebr)

// ORB box
var box orbBox = na
if showORB and afterORB and not na(orbHigh) and barstate.islast
    box.delete(orbBox)
    orbBox := box.new(orbBar, orbHigh, bar_index + 30, orbLow,
         bgcolor = colORB,
         border_color = color.new(#5cf2c5, 50),
         border_width = 1,
         extend = extend.right)

// Entry arrows
plotshape(longSig  and showSignal, "LONG",  shape.triangleup,   location.belowbar, color = colBull, size = size.large, text = "LONG",  textcolor = color.white)
plotshape(shortSig and showSignal, "SHORT", shape.triangledown, location.abovebar, color = colBear, size = size.large, text = "SHORT", textcolor = color.white)

// Entry price line for active trade
plot(showLevels and strategy.position_size != 0 ? strategy.position_avg_price : na, "Entry", color = color.new(#ffb454, 0), style = plot.style_linebr, linewidth = 2)

// ===================== STATUS PANEL =====================
if showPanel and barstate.islast
    var table tbl = table.new(position.top_right, 2, 12,
         bgcolor = color.new(#0b1020, 10),
         border_width = 1,
         border_color = color.new(#5cf2c5, 60))

    table.cell(tbl, 0, 0, "ORB-VWAP PRO",
         text_color = color.new(#5cf2c5, 0), text_size = size.normal,
         bgcolor = color.new(#0b1020, 0))
    table.cell(tbl, 1, 0, syminfo.ticker,
         text_color = color.white, text_size = size.small,
         bgcolor = color.new(#0b1020, 0))

    timeStr = str.tostring(istHour) + ":" + (istMin < 10 ? "0" : "") + str.tostring(istMin)
    timeCol = inExit ? colBear : afterORB ? colBull : color.gray
    table.cell(tbl, 0, 1, "Time IST",  text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, timeStr,     text_color = timeCol,    text_size = size.small)

    table.cell(tbl, 0, 2, "ORB High",  text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, na(orbHigh) ? "--" : str.tostring(orbHigh, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 3, "ORB Low",   text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, na(orbLow)  ? "--" : str.tostring(orbLow,  format.mintick), text_color = color.white, text_size = size.small)

    table.cell(tbl, 0, 4, "VWAP",      text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, str.tostring(vwapVal, format.mintick), text_color = color.white, text_size = size.small)

    trendStr = close > emaVal ? "BULLISH" : "BEARISH"
    trendCol = close > emaVal ? colBull : colBear
    table.cell(tbl, 0, 5, "Trend (50EMA)", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 5, trendStr,        text_color = trendCol,   text_size = size.small)

    posStr = strategy.position_size > 0 ? "LONG @ " + str.tostring(strategy.position_avg_price, format.mintick) : strategy.position_size < 0 ? "SHORT @ " + str.tostring(strategy.position_avg_price, format.mintick) : "FLAT"
    posCol = strategy.position_size > 0 ? colBull : strategy.position_size < 0 ? colBear : color.gray
    table.cell(tbl, 0, 6, "Position",  text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 6, posStr,      text_color = posCol,     text_size = size.small)

    table.cell(tbl, 0, 7, "Trades today", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 7, str.tostring(tradesToday) + " / " + str.tostring(maxTrades), text_color = color.white, text_size = size.small)

    table.cell(tbl, 0, 8, "Losses today", text_color = color.gray, text_size = size.small)
    lossCol = lossesToday >= maxLosses ? colBear : color.white
    table.cell(tbl, 1, 8, str.tostring(lossesToday) + " / " + str.tostring(maxLosses), text_color = lossCol, text_size = size.small)

    table.cell(tbl, 0, 9, "Net P&L (Rs)", text_color = color.gray, text_size = size.small)
    plCol = strategy.netprofit > 0 ? colBull : strategy.netprofit < 0 ? colBear : color.gray
    table.cell(tbl, 1, 9, str.tostring(strategy.netprofit, "+0.00"), text_color = plCol, text_size = size.small)

    table.cell(tbl, 0, 10, "Win rate", text_color = color.gray, text_size = size.small)
    winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0.0
    table.cell(tbl, 1, 10, str.tostring(winRate, "0.0") + "%  (" + str.tostring(strategy.closedtrades) + " trades)", text_color = color.white, text_size = size.small)

    statusStr = lossesToday >= maxLosses ? "STOPPED - max losses" : tradesToday >= maxTrades ? "STOPPED - max trades" : inExit ? "EOD - closing all" : strategy.position_size != 0 ? "IN TRADE" : afterORB ? "SCANNING" : inORB ? "Building ORB" : "Pre-market"
    statusCol = lossesToday >= maxLosses or tradesToday >= maxTrades or inExit ? colBear : strategy.position_size != 0 ? color.new(#ffb454, 0) : afterORB ? colBull : color.gray
    table.cell(tbl, 0, 11, "Status", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 11, statusStr, text_color = statusCol, text_size = size.small)

// ===================== ALERTS =====================
if longSig and alertEntry
    alert("ORB LONG on " + syminfo.ticker + "\nEntry: " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(orbLow, format.mintick) + "\nTP: " + str.tostring(close + (close - orbLow) * rrTarget, format.mintick) + "\nRisk <= 1% of capital.", alert.freq_once_per_bar_close)

if shortSig and alertEntry
    alert("ORB SHORT on " + syminfo.ticker + "\nEntry: " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(orbHigh, format.mintick) + "\nTP: " + str.tostring(close - (orbHigh - close) * rrTarget, format.mintick) + "\nRisk <= 1% of capital.", alert.freq_once_per_bar_close)

if alertExit and inExit and strategy.position_size != 0
    alert("EOD EXIT on " + syminfo.ticker + " at " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// =============================================================================
//  END
// =============================================================================
